{
  "ConfigSignature": {
    "ConfigPath": "deployment.config.json",
    "SignaturePath": "deployment.config.sig",
    "AllowUnsignedInDevelopment": false
  },
  "Database": {
    "ConnectionString": ""
  },
  "Auth": {
    "ApiKeyHeaderName": "X-Api-Key",
    "AdminKeyHeaderName": "X-Admin-Key",
    "Pepper": ""
  },
  "Bootstrap": {
    "Enabled": false,
    "TenantId": "11111111-1111-1111-1111-111111111111",
    "TenantName": "Default",
    "ApiKeyPlain": "",
    "ApiKeyLabel": "bootstrap"
  },
  "Rag": {
    "QdrantBaseUrl": "http://localhost:6333",
    "QdrantCollection": "knowledge_base",
    "EmbeddingsBaseUrl": "http://localhost:8081",
    "EmbeddingsModel": "intfloat/multilingual-e5-base",
    "EnableRerank": false,
    "RerankBaseUrl": "",
    "RerankModel": "",
    "RerankMaxCandidates": 12,
    "DefaultTopK": 5,
    "MaxTopK": 20,
    "SearchMaxConcurrency": 4,
    "SearchQueueLimit": 16,
    "SearchQueueWaitTimeoutSeconds": 25,
    "SearchRetryAfterSeconds": 3
  },
  "Ingestion": {
    "DocumentsRoot": "docs",
    "WatcherEnabled": true,
    "WatcherDebounceMs": 800,
    "MissingGraceSeconds": 120,
    "ChunkMaxWords": 220,
    "ChunkOverlapWords": 35,
    "ChunkMinWords": 25,
    "EmbeddingsBatchSize": 32,
    "EmbeddingsBatchAdaptiveRetryEnabled": true,
    "WorkerConcurrency": 2,
    "WorkerEmptyDelayMs": 500,
    "StaleRunningMinutes": 5,
    "ScannerEnabled": true,
    "ScanIntervalSeconds": 10,
    "MinFileAgeSeconds": 2,
    "MaxFilesPerScan": 5000,
    "DefaultCategory": "",
    "CategoryFromFirstFolder": true,
    "TeiTimeoutSeconds": 180,
    "QdrantTimeoutSeconds": 180,
    "TeiMaxConcurrency": 2,
    "QdrantMaxConcurrency": 4,
    "BulkheadAcquireTimeoutSeconds": 30,
    "OcrBulkheadAcquireTimeoutSeconds": 1800,
    "OcrEnabled": false,
    "OcrCommand": "",
    "OcrArguments": "",
    "OcrForceArguments": "",
    "OcrLanguages": "auto",
    "OcrAutoFallbackLanguages": "fra+eng+deu+ita+spa",
    "OcrMaxLanguages": 5,
    "OcrAutoDetectLanguages": true,
    "OcrTimeoutSeconds": 900,
    "OcrMinWords": 5,
    "OcrMaxConcurrency": 1,
    "OcrImagePageEnabled": true,
    "OcrImageRendererCommand": "gs",
    "OcrImageTextCommand": "tesseract",
    "OcrImagePageMaxPages": 0,
    "OcrImagePageRenderDpi": 220,
    "OcrImagePageSegmentationMode": 3,
    "OcrImagePageTimeoutSeconds": 120,
    "OcrImagePageMaxTotalSeconds": 1800,
    "OcrImagePageMinWords": 3
  },
  "CatalogSnapshot": {
    "Enabled": true,
    "IntervalSeconds": 300,
    "StartupDelaySeconds": 10,
    "MaxDocsPerTenant": 500000
  },
  "RuntimeGovernance": {
    "CapabilityBWorkerEnabled": true,
    "CapabilityBWorkerEmptyDelayMs": 5000,
    "CapabilityBWorkerErrorDelayMs": 1000,
    "CapabilityBRequireIngestionIdleForExecution": true,
    "CapabilityBRequireRagIdleForExecution": true,
    "CapabilityBAutoEnqueueWhenIngestionIdleEnabled": true,
    "CapabilityBIngestionIdleDelaySeconds": 900,
    "CapabilityBRagIdleDelaySeconds": 120,
    "CapabilityBRunningJobLeaseTimeoutSeconds": 3600,
    "CapabilityBAutoEnqueueBatchSize": 25,
    "CapabilityBAutoEnqueueTenantLimit": 8,
    "CapabilityBDocumentProfileSectionTitleLimit": 12,
    "CapabilityBDocumentProfileExcerptLimit": 10
  },

  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "saaia-backend",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
