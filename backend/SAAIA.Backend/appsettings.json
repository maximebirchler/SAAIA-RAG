{
  "ConfigSignature": {
    "ConfigPath": "deployment.config.json",
    "SignaturePath": "deployment.config.sig",
    "AllowUnsignedInDevelopment": false
  },
  "Database": {
    "ConnectionString": ""
  },
  "Auth": {
    "ApiKeyHeaderName": "X-Api-Key",
    "Pepper": ""
  },
  "Bootstrap": {
    "Enabled": false,
    "TenantId": "11111111-1111-1111-1111-111111111111",
    "TenantName": "Default",
    "ApiKeyPlain": "",
    "ApiKeyLabel": "bootstrap"
  },
  "Rag": {
    "QdrantBaseUrl": "http://localhost:6333",
    "QdrantCollection": "knowledge_base",
    "EmbeddingsBaseUrl": "http://localhost:8081",
    "EmbeddingsModel": "intfloat/multilingual-e5-base",
    "DefaultTopK": 5,
    "MaxTopK": 20
  },
  "Ingestion": {
    "DocumentsRoot": "docs",
    "WatcherEnabled": true,
    "WatcherDebounceMs": 800,
    "MissingGraceSeconds": 120,
    "ChunkMaxWords": 220,
    "ChunkOverlapWords": 35,
    "ChunkMinWords": 25,
    "EmbeddingsBatchSize": 16,
    "WorkerConcurrency": 2,
    "WorkerEmptyDelayMs": 500,
    "StaleRunningMinutes": 30,
    "ScannerEnabled": true,
    "ScanIntervalSeconds": 10,
    "MinFileAgeSeconds": 2,
    "MaxFilesPerScan": 5000,
    "DefaultCategory": "general",
    "CategoryFromFirstFolder": true,
    "TeiTimeoutSeconds": 180,
    "QdrantTimeoutSeconds": 180
  },
  "Chat": {
    "LlmBaseUrl": "http://127.0.0.1:1234",
    "LlmModel": "local",
    "LlmTemperature": 0.2,
    "LlmMaxTokens": 800,
    "LlmTimeoutSeconds": 120,
    "LlmFirstTokenTimeoutSeconds": 25,
    "SystemPrompt": "Tu es un assistant technique. Cite toujours la source avec doc et page."
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
