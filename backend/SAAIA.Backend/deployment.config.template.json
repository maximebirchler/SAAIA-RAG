{
  "Rag": {
    "QdrantBaseUrl": "http://localhost:6333",
    "TeiBaseUrl": "http://localhost:8081",
    "CollectionName": "saaia_docs_v1",
    "VectorSize": 768
  },
  "Ingestion": {
    "DocumentsRoot": "docs",
    "DefaultCategory": "general",
    "CategoryFromFirstFolder": true,
    "ChunkMaxChars": 1500,
    "ChunkOverlapChars": 200,
    "TeiBatchSize": 16,
    "WorkerConcurrency": 2,
    "PollSeconds": 2,
    "ScannerIntervalSeconds": 10,
    "WatcherDebounceMs": 800,
    "StaleRunningMinutes": 30,
    "QdrantTimeoutSeconds": 180,
    "TeiTimeoutSeconds": 180
  },
  "Chat": {
    "LlmBaseUrl": "http://localhost:8080",
    "LlmModel": "local",
    "Temperature": 0.2,
    "MaxTokens": 800,
    "SystemPrompt": "Tu es un assistant technique. Cite toujours la source avec doc et page."
  },
  "Bootstrap": {
    "Enabled": false
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 0
  }
}
