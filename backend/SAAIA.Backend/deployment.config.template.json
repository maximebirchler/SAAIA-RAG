{
  "Rag": {
    "QdrantBaseUrl": "http://localhost:6333",
    "QdrantCollection": "knowledge_base",
    "EmbeddingsBaseUrl": "http://localhost:8081",
    "EmbeddingsModel": "intfloat/multilingual-e5-base",
    "EnableRerank": false,
    "RerankBaseUrl": "",
    "RerankModel": "",
    "RerankMaxCandidates": 12,
    "DefaultTopK": 5,
    "MaxTopK": 60
  },
  "Ingestion": {
    "DocumentsRoot": "..\\..\\documents",
    "WatcherEnabled": true,
    "WatcherDebounceMs": 800,
    "MissingGraceSeconds": 120,
    "ChunkMaxWords": 220,
    "ChunkOverlapWords": 35,
    "ChunkMinWords": 25,
    "EmbeddingsBatchSize": 16,
    "EmbeddingsBatchAdaptiveRetryEnabled": true,
    "WorkerConcurrency": 2,
    "WorkerEmptyDelayMs": 500,
    "StaleRunningMinutes": 60,
    "ScannerEnabled": true,
    "ScanIntervalSeconds": 10,
    "MinFileAgeSeconds": 2,
    "MaxFilesPerScan": 5000,
    "DefaultCategory": "",
    "CategoryFromFirstFolder": true,
    "TeiTimeoutSeconds": 180,
    "QdrantTimeoutSeconds": 180,
    "TeiMaxConcurrency": 1,
    "QdrantMaxConcurrency": 4,
    "TeiInteractiveQuietPeriodMs": 1500,
    "BulkheadAcquireTimeoutSeconds": 30,
    "OcrBulkheadAcquireTimeoutSeconds": 1800,
    "OcrBulkheadQueueWaitTimeoutSeconds": 1800
  },
  "Bootstrap": {
    "Enabled": false
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "saaia-backend",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "CatalogSnapshot": {
    "Enabled": true,
    "IntervalSeconds": 300,
    "StartupDelaySeconds": 10,
    "MaxDocsPerTenant": 500000
  }
}
