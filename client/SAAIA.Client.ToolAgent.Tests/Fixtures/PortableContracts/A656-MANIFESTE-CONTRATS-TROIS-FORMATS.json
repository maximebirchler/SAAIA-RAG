  "authoritativeDocumentTools": [
    {
      "name": "documents_navigation",
      "internalNames": [
        "documents.navigation"
      ],
      "description": "Explore titres, sommaires, index et pages pour decouvrir des noms inconnus. kind=navigation_entry cible les entrees de sommaire/index; kind=title_anchor cible les autres titres; omettre kind conserve les deux. Retourne des pointeurs non citables a reutiliser ensuite dans une recherche groupee ou une lecture ciblee.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "categoryPath": {
            "type": "string",
            "description": "Chemin exact deja retourne par le catalogue ou un outil; sinon omettre ce filtre."
          },
          "docRef": {
            "type": "string"
          },
          "docPath": {
            "type": "string",
            "description": "Chemin documentaire exact retourne comme docPath. Copier le chemin complet, jamais un alias compact D1/D2."
          },
          "q": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "navigation_entry",
              "title_anchor"
            ]
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer",
            "description": "Position dans la pagination du meme outil avec exactement la meme requete et les memes filtres. Utiliser le nextOffset retourne pour cette route; une nouvelle requete commence normalement a 0."
          }
        },
        "additionalProperties": false
      },
      "parametersCompactSha256": "6C552D9FEF5DF50E1732D0525A378E24EA146FB8F69BCD9C900E97D6877AAEC4"
    },
    {
      "name": "documents_content_cards",
      "internalNames": [
        "documents.content_cards"
      ],
      "description": "Parcourt des candidats canoniques ancres par fichier/page. Ils ne sont pas preclasses semantiquement: juge titre, kind, headingPath et evidence. Avec q, filtre lexical. Sans q, inventoryMode=ordered suit l'ordre des sources; representative echantillonne des positions reparties dans chaque document. nextOffset poursuit la pagination stable.",
      "parameters": {
        "type": "object",
        "properties": {
          "categoryPath": {
            "type": "string",
            "description": "Chemin exact deja retourne par le catalogue ou un outil; sinon omettre ce filtre."
          },
          "categoryRef": {
            "type": "string"
          },
          "docRef": {
            "type": "string"
          },
          "docId": {
            "type": "string",
            "description": "Identifiant backend opaque retourne explicitement comme docId. Ne jamais y placer un docPath, un nom de fichier ou un alias D1/D2."
          },
          "docPath": {
            "type": "string",
            "description": "Chemin documentaire exact retourne comme docPath. Copier le chemin complet, jamais un alias compact D1/D2."
          },
          "q": {
            "type": "string"
          },
          "inventoryMode": {
            "type": "string",
            "enum": [
              "ordered",
              "representative"
            ]
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer",
            "description": "Position dans la pagination du meme outil avec exactement la meme requete et les memes filtres. Utiliser le nextOffset retourne pour cette route; une nouvelle requete commence normalement a 0."
          }
        },
        "additionalProperties": false
      },
      "parametersCompactSha256": "239B34A828197418B25A1BE64BEEFF89E570B7053318F7AFCAE48749004F4395"
    },
    {
      "name": "documents_context",
      "internalNames": [
        "documents.context"
      ],
      "description": "Lit le passage indexe autour d'un document, de pages ou d'un chunk deja localise. Copie un chunkId observe; sinon utilise les pages observees, sans synthetiser d'identifiant.",
      "parameters": {
        "type": "object",
        "properties": {
          "docRef": {
            "type": "string"
          },
          "docId": {
            "type": "string",
            "description": "Identifiant backend opaque retourne explicitement comme docId. Ne jamais y placer un docPath, un nom de fichier ou un alias D1/D2."
          },
          "docPath": {
            "type": "string",
            "description": "Chemin documentaire exact retourne comme docPath. Copier le chemin complet, jamais un alias compact D1/D2."
          },
          "chunkId": {
            "type": "string",
            "description": "Identifiant exact retourne comme chunkId par une observation. Ne jamais l'inventer. Si aucun chunkId n'est observe, omettre ce champ et reutiliser pageStart/pageEnd observes."
          },
          "pageStart": {
            "type": "integer"
          },
          "pageEnd": {
            "type": "integer"
          },
          "before": {
            "type": "integer"
          },
          "after": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer",
            "description": "Position dans la pagination du meme outil avec exactement la meme requete et les memes filtres. Utiliser le nextOffset retourne pour cette route; une nouvelle requete commence normalement a 0."
          }
        },
        "additionalProperties": false
      },
      "parametersCompactSha256": "E4983BF8035A87553BF443CDA7206D0AEFB83DD500CDB8611487A396FD95D068"
    },
    {
      "name": "rag_search",
      "internalNames": [
        "rag.search",
        "rag.multi_search"
      ],
      "description": "Recherche des termes susceptibles d'apparaitre dans la source et retourne des preuves citables. Plusieurs EvidenceId d'une meme page partagent le meme groupe_source. query cible une intention; queries regroupe plusieurs intentions. docPath/categoryPath affinent le corpus.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Termes compacts attendus dans la source. Exclure les jours, cases et libelles de mise en page sauf s'ils doivent apparaitre litteralement dans le document."
          },
          "topK": {
            "type": "integer"
          },
          "categoryPath": {
            "type": "string",
            "description": "Chemin exact deja retourne par le catalogue ou un outil; sinon omettre ce filtre."
          },
          "docId": {
            "type": "string",
            "description": "Identifiant backend opaque retourne explicitement comme docId. Ne jamais y placer un docPath, un nom de fichier ou un alias D1/D2."
          },
          "docPath": {
            "type": "string",
            "description": "Chemin documentaire exact retourne comme docPath. Copier le chemin complet, jamais un alias compact D1/D2."
          },
          "pageStart": {
            "type": "integer"
          },
          "pageEnd": {
            "type": "integer"
          },
          "maxPerDoc": {
            "type": "integer"
          },
          "maxPerPage": {
            "type": "integer"
          },
          "mode": {
            "type": "string",
            "enum": [
              "auto",
              "strict",
              "standard",
              "focused",
              "balanced",
              "broad"
            ]
          },
          "queries": {
            "type": "array",
            "description": "Intentions source complementaires. Chaque intention decrit un contenu a trouver, pas sa future case dans la reponse.",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "diversity": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "query"
            ]
          },
          {
            "required": [
              "queries"
            ]
          }
        ]
      },
      "parametersCompactSha256": "40A4B974C7F6FE2F44621F064E54D748AA0BEBBD7C0BF655974BA3BFC33A7CAB"
    }
