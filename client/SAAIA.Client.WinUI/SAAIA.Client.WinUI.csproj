<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SAAIA.Client.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SAAIA_Main.ico</ApplicationIcon>

    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>

    <!-- Unpackaged app (installer-friendly) -->
    <WindowsPackageType>None</WindowsPackageType>
    <AppxPackage>false</AppxPackage>

    <!-- Windows App SDK initialization strategy:
         - Use the bootstrapper auto-initializer (framework-dependent) to load the WinAppSDK framework package.
         - Disable DeploymentManager auto-initializer (we don't want runtime install/registration logic at startup).
         - Disable UndockedRegFreeWinRT auto-initializer (not needed when using the framework package). -->
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WindowsAppSdkUndockedRegFreeWinRTInitialize>false</WindowsAppSdkUndockedRegFreeWinRTInitialize>

    <!-- Avoid MSIX tooling interfering with CLI builds; keep it enabled in VS if you need it.
         If you still want it in VS, you can switch this back to true. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- CLI default: Platform=AnyCPU is not supported for WinUI/MSIX. Default to x64 unless explicitly set. -->
  <PropertyGroup Condition="'$(Platform)'=='' Or '$(Platform)'=='AnyCPU'">
    <Platform>x64</Platform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SAAIATestHooks)'=='true'">
    <DefineConstants>$(DefineConstants);SAAIA_TEST_HOOKS</DefineConstants>
  </PropertyGroup>

  <!-- PublishProfile is optional; only set it if the file exists to avoid NETSDK1198 warnings. -->
  <PropertyGroup Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\SAAIA_Main.png" />
    <Content Include="Assets\SAAIA_Icone.png" />
    <Content Include="Assets\SAAIA_Flat.png" />
    <Content Include="Assets\SAAIA_Main.ico" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7463" />
    <!-- Align with WinAppSDK 1.8.5 runtime (winget installs 1.8.5 -> 1.8.260209005) -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <!-- DPAPI (ProtectedData) pour chiffrer les secrets (M5.2) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\contracts\SAAIA.Contracts\SAAIA.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\config\llm-providers.dev.json" Link="config\llm-providers.dev.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    UserSettingsDialog source of truth:
    - The compiled dialog implementation is Controls\UserSettingsDialog.cs.
    - The legacy XAML files are intentionally kept on disk for reference only.
    - They must not participate in WinUI XAML compilation, otherwise XamlCompiler becomes fragile again.
    - Keep this configuration here in the project file as the single source of truth.
  -->
  <ItemGroup>
    <Page Remove="Controls\UserSettingsDialog.xaml" />
    <Compile Remove="Controls\UserSettingsDialog.xaml.cs" />
    <None Include="Controls\UserSettingsDialog.xaml" />
    <None Include="Controls\UserSettingsDialog.xaml.cs" />
  </ItemGroup>

</Project>
