<UserControl
    x:Class="SAAIA.Client.WinUI.Controls.LinkifiedTextBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
      Token renderer for assistant messages.
      We support two render modes:
        - RichText: general text + inline links.
        - LinesPanel: list/tree rendering with proper hanging indents.
    -->
    <Grid>
        <StackPanel x:Name="LinesPanel"
                    Visibility="Collapsed"
                    Spacing="0" />

        <RichTextBlock x:Name="Rtb"
                       TextWrapping="Wrap"
                       IsTextSelectionEnabled="False" />
    </Grid>
</UserControl>
