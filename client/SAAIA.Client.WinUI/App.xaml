<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SAAIA.Client.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SAAIA.Client.WinUI"
    xmlns:conv="using:SAAIA.Client.WinUI.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ✅ Utilisé pour afficher/cacher le label gris -->
            <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
