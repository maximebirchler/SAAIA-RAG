<Window
    x:Class="SAAIA.Client.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SAAIA.Client.WinUI.Controls"
    xmlns:models="using:SAAIA.Client.WinUI.Models"
    xmlns:conv="using:SAAIA.Client.WinUI.Converters"
    mc:Ignorable="d"
    Title="SAAIA">

    <Grid x:Name="Root" Padding="12,0,12,12" SizeChanged="Root_SizeChanged" Background="{ThemeResource AppWindowBackgroundBrush}">
        <Grid.Resources>

            <!-- converters -->
            <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibility" />

            <!-- =========================
                MESSAGE TEMPLATES (bulles)
                ========================= -->

            <!-- User bubble -->
            <DataTemplate x:Key="UserMessageTemplate" x:DataType="models:ChatMessageItem">
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="1"
                            Background="{ThemeResource AppUserBubbleBrush}"
                            BorderBrush="{ThemeResource AppAccentHoverBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,10"
                            MaxWidth="560"
                            HorizontalAlignment="Right"
                            PointerEntered="Bubble_PointerEntered"
                            PointerExited="Bubble_PointerExited">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                    Text="{x:Bind Content, Mode=OneWay}"
                                    Foreground="{ThemeResource AppTextOnAccentBrush}"
                                    TextWrapping="WrapWholeWords"
                                    IsTextSelectionEnabled="True"/>

                            <!-- Bottom bar: time (left) + copy icon (right) -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                        Text="{Binding CreatedAt, Converter={StaticResource DateTimeToLocalShort}}"
                                        Foreground="{ThemeResource AppTextOnAccentBrush}"
                                        Opacity="0.78"
                                        FontSize="11"
                                        VerticalAlignment="Center"/>

                                <Button x:Name="CopyBtn"
                                        Grid.Column="1"
                                        Click="CopyMessage_Click"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="2"
                                        Width="26"
                                        Height="22"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Copier"
                                        IsTabStop="False"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <FontIcon Glyph="&#xE8C8;"
                                            FontSize="14"
                                            Foreground="{ThemeResource AppTextOnAccentBrush}"
                                            Opacity="0.86" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- Assistant bubble -->
            <DataTemplate x:Key="AssistantMessageTemplate" x:DataType="models:ChatMessageItem">
                <Grid Margin="0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border Grid.Column="0"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="{ThemeResource AppAssistantAvatarBrush}"
                            VerticalAlignment="Top"
                            Margin="0,0,10,0">
                        <Image Source="ms-appx:///Assets/SAAIA_Icone.png"
                               Stretch="Uniform"
                               Opacity="0.9" />
                    </Border>

                    <Border Grid.Column="1"
                            Background="{ThemeResource AppAssistantBubbleBrush}"
                            BorderBrush="{ThemeResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,10"
                            MaxWidth="900"
                            HorizontalAlignment="Left"
                            PointerEntered="Bubble_PointerEntered"
                            PointerExited="Bubble_PointerExited">
                        <StackPanel Spacing="8">

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{Binding ProgressText, Converter={StaticResource NonEmptyStringToVisibility}}">
                                <ProgressRing Width="14"
                                              Height="14"
                                              IsActive="True"
                                              VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProgressText}"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="WrapWholeWords"/>
                            </StackPanel>

                            <controls:LinkifiedTextBlock Text="{x:Bind Content, Mode=OneWay}" TextForeground="{ThemeResource AppTextPrimaryBrush}" TextFontSize="14"/>

                            <!-- Status note (ex: Génération interrompue.) -->
                            <TextBlock Text="{Binding StatusNote}"
                                    Visibility="{Binding StatusNote, Converter={StaticResource NonEmptyStringToVisibility}}"
                                    Foreground="{ThemeResource AppTextSecondaryBrush}"
                                    FontSize="12"/>

                            <!-- Bottom bar: copy icon (left) + time (right) -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="CopyBtn"
                                        Grid.Column="0"
                                        Click="CopyMessage_Click"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="2"
                                        Width="26"
                                        Height="22"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Copier"
                                        IsTabStop="False"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <FontIcon Glyph="&#xE8C8;"
                                            FontSize="14"
                                            Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Button>

                                <TextBlock Grid.Column="2"
                                        Text="{Binding CreatedAt, Converter={StaticResource DateTimeToLocalShort}}"
                                        Foreground="{ThemeResource AppTextSecondaryBrush}"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- Selector -->
            <controls:ChatMessageTemplateSelector x:Key="ChatMessageTemplateSelector"
                                                UserTemplate="{StaticResource UserMessageTemplate}"
                                                AssistantTemplate="{StaticResource AssistantMessageTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =========================
             TITLE BAR (custom)
             ========================= -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              Margin="-12,0,-12,0"
              Background="{ThemeResource AppTitleBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Border Width="28"
                        Height="28"
                        CornerRadius="14"
                        Background="{ThemeResource AppTitleBarLogoBackgroundBrush}"
                        VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/SAAIA_Icone.png"
                           Width="20"
                           Height="20"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="SAAIA"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           FontWeight="SemiBold"
                           FontSize="15"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- =========================
             HEADER (compact)
             ========================= -->
        <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Chats toggle (hamburger) -->
            <Button x:Name="ChatsToggleButton"
                    Width="36"
                    Height="36"
                    Margin="0,0,4,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="ChatsToggle_Click"
                    ToolTipService.ToolTip="Chats"
                    Style="{StaticResource AppIconButtonStyle}"
                    IsTabStop="False">
                <FontIcon Glyph="&#xE700;" FontSize="18" />
            </Button>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="SetupButton"
                        Width="40"
                        Height="40"
                        Margin="0,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Click="SetupWizard_Click"
                        ToolTipService.ToolTip="Configuration"
                        Style="{StaticResource AppIconButtonStyle}"
                        Visibility="Collapsed"
                        IsTabStop="False">
                    <FontIcon Glyph="&#xE90F;" FontSize="18" />
                </Button>

                <Button x:Name="HeaderHelpButton"
                        Width="40"
                        Height="40"
                        Margin="0,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Click="HelpButton_Click"
                        ToolTipService.ToolTip="Aide"
                        Style="{StaticResource AppIconButtonStyle}"
                        IsTabStop="False">
                    <TextBlock Text="?" FontSize="18" FontWeight="SemiBold" />
                </Button>

                <!-- Settings -->
                <Button x:Name="HeaderSettingsButton"
                        Width="40"
                        Height="40"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        Click="UserSettings_Click"
                        ToolTipService.ToolTip="Paramètres"
                        Style="{StaticResource AppIconButtonStyle}"
                        IsTabStop="False">
                    <FontIcon Glyph="&#xE713;" FontSize="19" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- =========================
             TOP BAR (settings)
             ========================= -->
        <!-- =========================
             TOP BAR (legacy / hidden)
             ========================= -->
        <Grid Grid.Row="1" RowSpacing="8" ColumnSpacing="10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="Auto"/> <!-- Connect -->
                <ColumnDefinition Width="Auto"/> <!-- LLM -->
                <ColumnDefinition Width="Auto"/> <!-- Sources -->
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server URL" FontWeight="SemiBold" Visibility="Collapsed"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="API Key (X-Api-Key)" FontWeight="SemiBold" Visibility="Collapsed"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="LLM URL (OpenAI compat)" FontWeight="SemiBold" Visibility="Collapsed"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="LLM Model" FontWeight="SemiBold" Visibility="Collapsed"/>

            <TextBox Grid.Row="1" Grid.Column="0" x:Name="ServerUrlBox" IsReadOnly="True" Visibility="Collapsed"/>
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox" Visibility="Collapsed"/>
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="LlmUrlBox" IsReadOnly="True" Visibility="Collapsed"/>
            <TextBox Grid.Row="1" Grid.Column="3" x:Name="LlmModelBox" IsReadOnly="True" Visibility="Collapsed"/>

            <Button Grid.Row="1" Grid.Column="4"
                    x:Name="ConnectButton"
                    Content="Connect"
                    Click="Connect_Click"
                    MinWidth="120"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"/>

            <!-- ✅ Visible seulement quand la colonne Sources est cachée (petit écran) -->
            
                        <StackPanel Grid.Row="1" Grid.Column="5"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Bottom">

                <!-- User settings (safe) -->
<Button x:Name="UserSettingsButton"
        Content="Paramètres"
        MinWidth="120"
        Click="UserSettings_Click"
        VerticalAlignment="Bottom"/>


                <Button
                                    x:Name="LlmSettingsButton"
                                    Content="LLM"
                                    MinWidth="80"
                                    VerticalAlignment="Bottom"
                                    Visibility="Collapsed">
                                <Button.Flyout>
                                    <Flyout Placement="Bottom">
                                        <ScrollViewer MaxWidth="560" MaxHeight="620"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="10" Padding="12">
                
                                                <TextBlock Text="Local LLM (llama.cpp)" FontWeight="SemiBold" FontSize="16"/>
                
                                                <CheckBox x:Name="LocalLlmEnabledCheck" Content="Enable local LLM (llama.cpp)" />
                                                <CheckBox x:Name="LocalLlmAutoStartCheck" Content="Auto-start local LLM on Connect" />
                
                                                <TextBlock Text="Server executable (llama-server.exe)" FontWeight="SemiBold"/>
                                                <TextBox x:Name="LocalLlmExePathBox" PlaceholderText="C:\SAAIA\llm\llama-server.exe"/>
                
                                                
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Button Content="Browse…" Click="LocalLlmBrowseExe_Click" MinWidth="90"/>
                                                </StackPanel>
                
                                                <TextBlock Text="Model (.gguf)" FontWeight="SemiBold"/>
                                                <TextBox x:Name="LocalLlmModelPathBox" PlaceholderText="C:\SAAIA\models\Mistral-7B-Instruct-v0.3-IQ3_M.gguf"/>
                
                                                
                
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Button Content="Browse…" Click="LocalLlmBrowseModel_Click" MinWidth="90"/>
                                                    <Button Content="Import to library" Click="LocalLlmImportModel_Click" MinWidth="150"/>
                                                    <Button Content="Open folder" Click="LocalLlmOpenModelsFolder_Click" MinWidth="120"/>
                                                </StackPanel>
                
                                                <TextBlock x:Name="LocalLlmModelInfoText" Opacity="0.8" TextWrapping="Wrap"/>
                
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="1*"/>
                                                    </Grid.ColumnDefinitions>
                
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="Host" FontWeight="SemiBold"/>
                                                        <TextBox x:Name="LocalLlmHostBox" PlaceholderText="127.0.0.1"/>
                                                    </StackPanel>
                
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="Port" FontWeight="SemiBold"/>
                                                        <TextBox x:Name="LocalLlmPortBox" PlaceholderText="1234"/>
                                                    </StackPanel>
                                                </Grid>
                
                                                <TextBlock Text="Model ID (OpenAI 'model')" FontWeight="SemiBold"/>
                                                <TextBox x:Name="LocalLlmModelIdBox" PlaceholderText="Mistral-7B-Instruct-v0.3-IQ3_M.gguf"/>
                
                                                <TextBlock Text="Extra args (optional)" FontWeight="SemiBold"/>
                                                <TextBox x:Name="LocalLlmExtraArgsBox"
                                                         AcceptsReturn="False"
                                                         TextWrapping="Wrap"
                                                         PlaceholderText="--ctx-size 4096"/>
                
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Button Content="Start now" Click="LocalLlmStart_Click" MinWidth="110"/>
                                                    <Button Content="Stop" Click="LocalLlmStop_Click" MinWidth="80"/>
                                                    <Button Content="Save" Click="LocalLlmSave_Click" MinWidth="80"/>
                                                </StackPanel>
                
                                                <TextBlock x:Name="LocalLlmStatusText" Opacity="0.8" TextWrapping="Wrap"/>
                
                                                <TextBlock Text="Command line (for support)" FontWeight="SemiBold"/>
                                                <TextBox x:Name="LocalLlmCmdLineBox"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="False"
                                                         TextWrapping="Wrap"
                                                         MinHeight="60"/>
                
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                
                                        </StackPanel>
<Button Grid.Row="1" Grid.Column="6"
                    x:Name="SourcesToggleButton"
                    Content="Sources"
                    Click="SourcesToggle_Click"
                    MinWidth="120"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7"
                       x:Name="StatusText"
                       Opacity="0.85"
                       TextWrapping="WrapWholeWords"/>
        </Grid>

        <!-- =========================
             BODY : chats + messages + sources
             ========================= -->
        <Grid Grid.Row="2" Margin="0,0,0,0" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <!-- gauche : chats -->
                <ColumnDefinition x:Name="ChatsCol" Width="280" MinWidth="0"/>
                <!-- milieu : messages -->
                <ColumnDefinition Width="*"/>
                <!-- droite : sources (peut être cachée en petit écran) -->
                <ColumnDefinition x:Name="SourcesCol" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT : Chats panel ===== -->
            <Border x:Name="ChatsPanel"
                    Grid.Column="0"
                    Style="{StaticResource AppPanelBorderStyle}"
                    Padding="12"
                    Margin="0,0,12,0">

                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="Transparent" Padding="2,2,8,2" HorizontalAlignment="Left" VerticalAlignment="Center" PointerPressed="ChatsSecretHotzone_PointerPressed">
                            <TextBlock x:Name="ChatsHeaderText" Text="Chats" FontWeight="SemiBold" FontSize="16"/>
                        </Border>
                        <Button Grid.Column="1"
                                x:Name="NewChatButton"
                                Content="New"
                                Click="NewChat_Click"
                                MinWidth="80"
                                Style="{StaticResource AppSecondaryButtonStyle}"/>
                    </Grid>

                    <ListView Grid.Row="1"
                              x:Name="SessionsList"
                              SelectionChanged="SessionsList_SelectionChanged"
                              ItemContainerStyle="{StaticResource AppSidebarListItemStyle}"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatSessionItem">
                                <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                        BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                        BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}"
                                        CornerRadius="16"
                                        Padding="12,12,10,12">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="4"
                                                Margin="0,4,0,4"
                                                CornerRadius="3"
                                                Background="{ThemeResource AppAccentBrush}"
                                                Opacity="{x:Bind SelectionAccentOpacity, Mode=OneWay}"/>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind DisplaySubtitle}"
                                                       Opacity="0.72"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="…"
                                                Width="32"
                                                Height="32"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource AppCompactButtonStyle}">
                                            <Button.Flyout>
                                                <MenuFlyout Opening="SessionMenu_Opening">
                                                    <MenuFlyoutItem Text="Rename" Click="SessionRename_Click" CommandParameter="{Binding}"/>
                                                    <MenuFlyoutItem Text="Delete" Click="SessionDelete_Click" CommandParameter="{Binding}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ===== CENTER : Messages ===== -->
            <Border x:Name="MessagesPanelBorder"
                    Grid.Column="1"
                    Background="{ThemeResource AppPanelElevatedBackgroundBrush}"
                    BorderBrush="{ThemeResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scroll + list -->
                    <ScrollViewer x:Name="MessagesScroll"
                                  Grid.Row="0"
                                  ViewChanged="MessagesScroll_ViewChanged"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ListView x:Name="MessagesList"
                                SelectionMode="None"
                                ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"
                                HorizontalContentAlignment="Stretch"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </ScrollViewer>

                    <!-- Typing + jump -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TypingText"
                                   Text="Typing…"
                                   Foreground="{ThemeResource AppTextMutedBrush}"
                                   Opacity="0.85"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                x:Name="JumpBottomButton"
                                Content="Jump to bottom"
                                Click="JumpBottom_Click"
                                Visibility="Collapsed"
                                Style="{StaticResource AppSecondaryButtonStyle}"/>
                    </Grid>

                    <!-- INPUT (inside chat panel) -->
                    <Grid Grid.Row="2" Margin="0,10,0,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="InputBox"
                                 Style="{StaticResource AppComposerTextBoxStyle}"
                                 PlaceholderText="Tape ta question..."
                                 AcceptsReturn="False"
                                 TextWrapping="Wrap"
                                 MinHeight="44"
                                 MaxHeight="220"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 KeyDown="InputBox_KeyDown"
                                 TextChanged="InputBox_TextChanged" />

                        <Button Grid.Column="1"
                                x:Name="SendCancelButton"
                                Click="SendCancel_Click"
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                ToolTipService.ToolTip="Envoyer"
                                IsTabStop="False"
                                CornerRadius="14"
                                Padding="0"
                                BorderThickness="1">
                            <FontIcon x:Name="SendCancelIcon" Glyph="&#xE724;" FontSize="18" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== RIGHT : Sources ===== -->
            <Border x:Name="SourcesPanel"
                    Grid.Column="2"
                    Style="{StaticResource AppPanelBorderStyle}"
                    Padding="12"
                    Visibility="Collapsed">

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <TextBlock Text="Sources" FontWeight="SemiBold" FontSize="16" Foreground="{ThemeResource AppTextPrimaryBrush}"/>

                        <controls:SourcesCardsControl x:Name="SourcesCards" />

                        <!-- Debug JSON (si tu veux le laisser caché) -->
                        <TextBox x:Name="SourcesBox"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="False"
                                 Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Input bar moved inside the Messages panel (Grid.Row=1 / center column). -->
    </Grid>
</Window>
