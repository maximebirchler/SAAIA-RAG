<Window
    x:Class="SAAIA.Client.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:SAAIA.Client.WinUI.Controls"
    mc:Ignorable="d"
    Title="SAAIA Client">

    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings -->
        <Grid RowSpacing="8" ColumnSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server URL" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="API Key (X-Api-Key)" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="LLM URL (OpenAI compat)" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="0" Grid.Column="3" Text="LLM Model" FontWeight="SemiBold"/>

            <TextBox Grid.Row="1" Grid.Column="0" x:Name="ServerUrlBox" PlaceholderText="http://localhost:5122" IsReadOnly="True"/>
            <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox"/>
            <TextBox Grid.Row="1" Grid.Column="2" x:Name="LlmUrlBox" PlaceholderText="http://localhost:1234/v1" IsReadOnly="True"/>
            <TextBox Grid.Row="1" Grid.Column="3" x:Name="LlmModelBox" PlaceholderText="mistral" IsReadOnly="True"/>

            <Button Grid.Row="1" Grid.Column="4"
                    x:Name="ConnectButton"
                    Content="Connect"
                    Click="Connect_Click"
                    MinWidth="120"
                    VerticalAlignment="Bottom"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                       x:Name="StatusText"
                       Opacity="0.85"
                       TextWrapping="WrapWholeWords"/>
        </Grid>

        <!-- Messages -->
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView x:Name="MessagesList" Grid.Column="0" SelectionChanged="MessagesList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#2D2D2D" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" FontWeight="Bold"/>

                                <TextBlock Text="{Binding Content}"
                                        TextWrapping="WrapWholeWords"
                                        Margin="0,6,0,0"/>

                                <!-- ✅ Petit label gris (style ChatGPT) -->
                                <Border Margin="0,8,0,0"
                                        Padding="8,6"
                                        CornerRadius="6"
                                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                                        Visibility="{Binding StatusNote, Converter={StaticResource NonEmptyStringToVisibility}}">
                                    <TextBlock Text="{Binding StatusNote}"
                                            FontSize="12"
                                            Opacity="0.70"/>
                                </Border>

                                <TextBlock Text="{Binding CreatedAt}" Opacity="0.6" FontSize="12" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

            <!-- Sources -->
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0">
                <StackPanel Spacing="12">

                    <controls:SourcesCardsControl x:Name="SourcesCards" />

                    <!-- Debug JSON (caché) -->
                    <TextBlock Text="Sources (JSON)" FontWeight="SemiBold" Opacity="0.7" Visibility="Collapsed"/>
                    <TextBox x:Name="SourcesBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Height="520"
                             Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Input -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="InputBox"
                     PlaceholderText="Tape ta question..."
                     KeyDown="InputBox_KeyDown"/>

            <Button Grid.Column="1"
                    x:Name="SendButton"
                    Content="Send"
                    Click="Send_Click"
                    Margin="10,0,0,0"/>

            <Button Grid.Column="2"
                    x:Name="CancelButton"
                    Content="Cancel"
                    Click="Cancel_Click"
                    Margin="10,0,0,0"
                    IsEnabled="False"/>

            <Button Grid.Column="3"
                    x:Name="NewChatButton"
                    Content="New chat"
                    Click="NewChat_Click"
                    Margin="10,0,0,0"
                    IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
