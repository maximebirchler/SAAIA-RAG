# Root Docker build context for infra/docker-compose.prod.yml.
# Keep the remote build payload limited to backend publish inputs.
*

!RAG.sln
!global.json

!contracts/
!contracts/SAAIA.Contracts/
!contracts/SAAIA.Contracts/**

!backend/
!backend/SAAIA.Backend/
!backend/SAAIA.Backend/**

**/bin/
**/obj/
**/.vs/
**/.idea/
*.user
*.suo

.git/
.gitignore
.gitattributes

infra/
client/
artifacts/
documents/
data/
logs/
models/
Images/
Test Bench/
support-bundles/

**/*.log
**/*.tmp
**/*.bak
**/*.zip
**/*.7z
**/*.tgz
**/*.tar.gz
**/*.pdf
**/*.gguf
**/*.bin
**/*.safetensors

**/.env
**/.env.*
!**/.env.example
**/appsettings.Local.json
**/appsettings.*.local.json
**/deployment.config.json
**/deployment.config.sig
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.pfx
**/*.p8
**/*.p12
**/keys/
**/private*.b64
