# Timezone
TZ=Europe/Zurich

# Postgres
POSTGRES_DB=saaia
POSTGRES_USER=saaia
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# POSTGRES_HOST_PORT=5432

# Qdrant (port host bind localhost)
QDRANT_HOST_PORT=6333
# QDRANT_API_KEY=CHANGE_ME_IF_ENABLED

# TEI (embeddings)
TEI_HOST_PORT=8081
TEI_MODEL_ID=intfloat/multilingual-e5-base

# llama.cpp server (OpenAI-compatible)
LLM_HOST_PORT=1234

# --- LLM MODEL (Mistral v0.3) ---
# ID informatif (utile côté backend/config)
LLM_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.3

# Nom du fichier GGUF présent dans RAG/models/
LLM_MODEL_FILE=Mistral-7B-Instruct-v0.3-Q6_K.gguf

# Alias compat (si tu réutilises certains scripts/README)
LLM_MODEL=Mistral-7B-Instruct-v0.3-Q6_K.gguf

# Pour vérifier que le téléchargement est complet
LLM_MODEL_SIZE_BYTES=5947248864
LLM_MODEL_SHA256=757D75DF89821A94841F341F3270B0709D36891DD8FBC41DFD059D213B54C3F5

# URL directe pour download (HuggingFace)
LLM_MODEL_URL=https://huggingface.co/bartowski/Mistral-7B-Instruct-v0.3-GGUF/resolve/main/Mistral-7B-Instruct-v0.3-Q6_K.gguf?download=true

# Réglages "safe" 16GB RAM (CPU)
LLM_CTX_SIZE=4096
LLM_N_PARALLEL=1

# LLM_THREADS=8
# LLM_BATCH=512
LLM_METRICS=1