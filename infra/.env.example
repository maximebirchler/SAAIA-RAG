# ==========================
# SAAIA - PROD 
# ==========================
TZ=Europe/Zurich

# ==========================
# OPTIONAL: Install root (bind-mount base)
# ==========================
# By default, data + config + documents are stored in the *repo root*.
# To store everything outside the repo, set an absolute path here.
#
# Windows (Docker Desktop): use forward slashes
# SAAIA_INSTALL_ROOT=C:/SAAIA
#
# Linux:
#   SAAIA_INSTALL_ROOT=/opt/saaia
#
# (If unset: defaults to repo root)
# SAAIA_INSTALL_ROOT=


# ==========================
# Bind address (security)
# ==========================
# Par défaut, on bind les ports en local uniquement.
# Pour exposer sur LAN/WAN (reverse-proxy/TLS recommandé) : SAAIA_BIND_ADDR=0.0.0.0
SAAIA_BIND_ADDR=127.0.0.1


# ==========================
# Ports host (mapping)
# ==========================
BACKEND_HOST_PORT=5122
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333
TEI_HOST_PORT=8081

# ==========================
# Postgres
# ==========================
POSTGRES_DB=saaia
POSTGRES_USER=saaia
POSTGRES_PASSWORD=CHANGE_ME_STRONG

# ==========================
# Qdrant
# ==========================
QDRANT_API_KEY=CHANGE_ME_STRONG
# En prod: on veut forcer l'usage de la clé (bloque si pas de key)
REQUIRE_QDRANT_AUTH_IN_PROD=true

# ==========================
# TEI
# ==========================
TEI_MODEL_ID=intfloat/multilingual-e5-base
# Optional (only for gated models)
# HF_TOKEN=

# Multilingual CPU reranker. Lower the limits on smaller hosts or disable it
# only after a measured retrieval-quality comparison.
SAAIA_RERANK_ENABLED=true
SAAIA_RERANK_MODEL_ID=Alibaba-NLP/gte-multilingual-reranker-base
SAAIA_RERANK_MODEL_REVISION=52ac27fc088c42ad6b4371003e4c0b00d6c11282
SAAIA_RERANK_MAX_CANDIDATES=12
SAAIA_RERANK_CPUS=6.0
SAAIA_RERANK_THREADS=6
SAAIA_RERANK_MEMORY_LIMIT=8g

# ==========================
# Secrets applicatifs (utilisés pour générer le deployment.config signé)
# ==========================
SAAIA_AUTH_PEPPER=CHANGE_ME_LONG_RANDOM
SAAIA_BOOTSTRAP_API_KEY=CHANGE_ME_LONG_RANDOM

# Bootstrap : true au premier démarrage (crée tenant + clé admin).
# Après hardening (création d'autres clés + révocation bootstrap), mets false puis re-signe.
SAAIA_BOOTSTRAP_ENABLED=true

# Licence produit : nombre de seats autorisés.
# Utilisé pour recalculer le modèle serveur, les instances, les slots et la file LLM.
SAAIA_LICENSE_SEATS=1

# ==========================
# Server LLM (optional)
# ==========================
# Server LLM is backoffice-only: ingestion enrichment, summaries and document profiles.
# It is not used for end-user chat, which remains client-side per CDC v3.1.
BACKOFFICE_LLM_ENABLED=false
# Leave CHAT_LLM_BASE_URL empty when the backoffice LLM is not installed.
# When install-llm.ps1 runs beside the prod compose, use the Docker network URL.
# Linux prod example: CHAT_LLM_BASE_URL=http://saaia-llama:8080
CHAT_LLM_BASE_URL=
CHAT_LLM_MODEL=Qwen_Qwen3-4B-Instruct-2507-Q5_K_M.gguf
CHAT_LLM_API_MODE=llama_completion
CHAT_LLM_PROMPT_FORMAT=chatml
# Optional OpenAI-compatible request template. Required for the Qwen3 llama.cpp
# chat-completions mode only. Leave empty for the native completion profile.
CHAT_LLM_CHAT_TEMPLATE=
# Set true only if CHAT_LLM_BASE_URL points to a real router/load balancer able to route
# several llama.cpp instances. Otherwise backend queue capacity is capped to one instance.
BACKOFFICE_LLM_MULTI_INSTANCE_ROUTER_ENABLED=false
# Optional: attach generated LLM compose to the backend Docker network.
# Linux prod default when compose project is infra: SAAIA_LLM_DOCKER_NETWORK=infra_default
SAAIA_LLM_DOCKER_NETWORK=

# Révision Hugging Face immuable du modèle TEI. Ne pas laisser "main" en production.
TEI_MODEL_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
# Les images sont épinglées par digest dans le compose ; overrides optionnels.
TEI_IMAGE=
QDRANT_IMAGE=

# ==========================
# RAG search capacity
# ==========================
# With defaults, 4 requests run immediately and 16 can wait briefly.
# Extra concurrent requests receive 429 rag_search_busy with Retry-After.
SAAIA_RAG_SEARCH_MAX_CONCURRENCY=4
SAAIA_RAG_SEARCH_QUEUE_LIMIT=16
SAAIA_RAG_SEARCH_QUEUE_WAIT_TIMEOUT_SECONDS=25
SAAIA_RAG_SEARCH_RETRY_AFTER_SECONDS=3

# ==========================
# Ingestion capacity
# ==========================
# Conservative defaults. Increase only after server bench/monitoring.
SAAIA_INGESTION_CHUNK_MAX_WORDS=200
SAAIA_INGESTION_CHUNK_OVERLAP_WORDS=35
SAAIA_INGESTION_CHUNK_MIN_WORDS=25
SAAIA_INGESTION_EMBEDDINGS_BATCH_SIZE=32
SAAIA_INGESTION_CANONICAL_ARTIFACTS_ENABLED=true
SAAIA_INGESTION_WORKER_CONCURRENCY=2
SAAIA_INGESTION_WORKER_EMPTY_DELAY_MS=500
SAAIA_INGESTION_SCANNER_ENABLED=true
SAAIA_INGESTION_SCAN_INTERVAL_SECONDS=10
SAAIA_INGESTION_MIN_FILE_AGE_SECONDS=2
SAAIA_INGESTION_MAX_FILES_PER_SCAN=5000
SAAIA_INGESTION_TEI_TIMEOUT_SECONDS=180
SAAIA_INGESTION_QDRANT_TIMEOUT_SECONDS=180
SAAIA_INGESTION_TEI_MAX_CONCURRENCY=2
SAAIA_INGESTION_QDRANT_MAX_CONCURRENCY=4
SAAIA_INGESTION_TEI_INTERACTIVE_QUIET_PERIOD_MS=1500
SAAIA_INGESTION_HEAVY_COMPUTE_MAX_CONCURRENCY=1
SAAIA_INGESTION_BULKHEAD_ACQUIRE_TIMEOUT_SECONDS=30
SAAIA_INGESTION_OCR_BULKHEAD_ACQUIRE_TIMEOUT_SECONDS=1800
SAAIA_INGESTION_OCR_BULKHEAD_QUEUE_WAIT_TIMEOUT_SECONDS=21600
SAAIA_INGESTION_HEAVY_COMPUTE_QUEUE_WAIT_TIMEOUT_SECONDS=21600

# Structured document intelligence. Defaults match the pinned CPU image in
# docker-compose.prod.yml. Keep one local worker so all conversions share the
# same model allocation; ingestion concurrency is governed by the backend.
SAAIA_DOCUMENT_INTELLIGENCE_ENABLED=true
DOCLING_IMAGE=
SAAIA_DOCLING_IMAGE=
SAAIA_DOCLING_DEVICE=cpu
SAAIA_DOCLING_CPUS=8.0
SAAIA_DOCLING_MEMORY_LIMIT=14g
SAAIA_DOCLING_PIDS_LIMIT=1024
SAAIA_DOCLING_NUM_THREADS=8
SAAIA_DOCLING_WORKERS=1
SAAIA_DOCLING_TIMEOUT_SECONDS=900
SAAIA_DOCLING_MAX_SYNC_WAIT_SECONDS=900
SAAIA_DOCLING_MAX_RESPONSE_BYTES=536870912
SAAIA_DOCLING_MAX_FILE_SIZE=536870912
SAAIA_DOCLING_MAX_PAGES=1000
SAAIA_DOCLING_OCR_ENABLED=true
SAAIA_DOCLING_FORCE_OCR=false
SAAIA_DOCLING_OCR_PRESET=auto
SAAIA_DOCLING_PDF_BACKEND=docling_parse
SAAIA_DOCLING_TABLE_MODE=accurate
SAAIA_DOCLING_TABLE_CELL_MATCHING=true
SAAIA_DOCLING_TABLE_STRUCTURE_ENABLED=true
SAAIA_DOCLING_TABLE_REPAIR_ENABLED=true
SAAIA_DOCLING_TABLE_REPAIR_SCALE=2.5
SAAIA_DOCLING_TABLE_REPAIR_PADDING_POINTS=12
SAAIA_DOCLING_TABLE_REPAIR_MINIMUM_SCORE=0.5
SAAIA_DOCLING_NATIVE_TEXT_RECONCILIATION_ENABLED=true
SAAIA_DOCLING_NATIVE_TEXT_MINIMUM_LINE_COVERAGE=0.90
SAAIA_DOCLING_NATIVE_PDF_IMAGE_INVENTORY_ENABLED=true
SAAIA_DOCLING_HEADING_HIERARCHY_ENABLED=true
SAAIA_DOCLING_HEADING_HIERARCHY_USE_BOOKMARKS=true
SAAIA_DOCLING_HEADING_HIERARCHY_USE_NUMBERING=true
SAAIA_DOCLING_HEADING_HIERARCHY_USE_STYLE=true
SAAIA_DOCLING_HEADING_HIERARCHY_MAX_LEVEL=6
SAAIA_DOCLING_HEADING_HIERARCHY_BOOKMARK_THRESHOLD=0.8

# OCR. "auto" stays bounded even when all Tesseract languages are installed.
# Explicit Tesseract lists are allowed and are not capped by SAAIA_OCR_MAX_LANGUAGES,
# e.g. eng+fra+nld+srp_latn+script/Latin.
SAAIA_OCR_ENABLED=true
SAAIA_OCR_COMMAND=ocrmypdf
SAAIA_OCR_ARGUMENTS=--rotate-pages --deskew --clean --skip-text --tesseract-pagesegmode 3 -l {languages} --sidecar {sidecar} {input} {output}
SAAIA_OCR_FORCE_ARGUMENTS=--rotate-pages --deskew --clean --force-ocr --tesseract-pagesegmode 3 -l {languages} --sidecar {sidecar} {input} {output}
SAAIA_OCR_LANGUAGES=auto
SAAIA_OCR_AUTO_FALLBACK_LANGUAGES=fra+eng+deu+ita+spa
SAAIA_OCR_MAX_LANGUAGES=5
SAAIA_OCR_AUTO_DETECT_LANGUAGES=true
SAAIA_OCR_TIMEOUT_SECONDS=3600
SAAIA_OCR_MIN_WORDS=5
SAAIA_OCR_MAX_CONCURRENCY=1
SAAIA_OCR_IMAGE_PAGE_ENABLED=true
SAAIA_OCR_IMAGE_RENDERER_COMMAND=gs
SAAIA_OCR_IMAGE_TEXT_COMMAND=tesseract
SAAIA_OCR_IMAGE_PAGE_MAX_PAGES=0
SAAIA_OCR_IMAGE_PAGE_RENDER_DPI=400
SAAIA_OCR_IMAGE_PAGE_SEGMENTATION_MODE=11
SAAIA_OCR_IMAGE_PAGE_TIMEOUT_SECONDS=180
SAAIA_OCR_IMAGE_PAGE_MAX_TOTAL_SECONDS=1800
SAAIA_OCR_IMAGE_PAGE_MIN_WORDS=3

# Chemin vers un fichier qui contient UNIQUEMENT la clé privée Ed25519 en base64 (32 bytes RawPrivateKey)
# IMPORTANT: ce fichier doit être hors repo
SAAIA_CONFIG_PRIVATE_KEY_PATH=Path\To\PrivateKey\saaia_private_key.b64

# Dossier de déploiement (relatif à InstallRoot)
# Valeur recommandée : 'deploy' (le compose monte <InstallRoot>/deploy)
SAAIA_DEPLOY_DIR=deploy

# ======================
# OpenTelemetry (optional)
# ======================
# Démarrer le collector local lors de l'installation (install.ps1 -WithOtel)
# SAAIA_INSTALL_WITH_OTEL=true

# Si tu lances le collector via docker-compose (profile otel),
# tu peux forcer l’export OTLP du backend vers le collector :
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ====================
# PROXY (optional)
# ====================
# HTTP_PROXY=http://http.docker.internal:3128
# HTTPS_PROXY=http://http.docker.internal:3128
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,http.docker.internal,qdrant,tei,postgres,n8n
