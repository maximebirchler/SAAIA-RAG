{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SAAIA Writer Output Schema v2.8.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finalAnswer",
    "sources"
  ],
  "properties": {
    "finalAnswer": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "docPath",
          "pageStart",
          "pageEnd",
          "label"
        ],
        "properties": {
          "docPath": {
            "type": "string"
          },
          "docName": {
            "type": "string"
          },
          "pageStart": {
            "type": "integer",
            "minimum": 1
          },
          "pageEnd": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "suggestedFollowUps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "renderHint": {
          "type": "string",
          "enum": [
            "auto",
            "brief",
            "detailed",
            "bullets",
            "count_only",
            "list",
            "tree",
            "table"
          ],
          "description": "Hint for UI rendering, usually equals Router responseFormat."
        }
      },
      "required": []
    }
  },
  "$id": "https://saaia.local/schemas/writer.schema.v2.8.1.json",
  "version": "v2.8.1"
}
